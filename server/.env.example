# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Dev (SQLite, cero setup): DATABASE_URL="file:./dev.db"
# Prod (Postgres): DATABASE_URL="postgresql://user:password@host:5432/cumbre"
# Nota: al pasar a Postgres, cambiar también `provider = "postgresql"` en prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# --- Storage de media ---
# "local" guarda en server/uploads/. "s3" sube a S3 o Cloudflare R2 (mismo
# código en src/lib/storage.ts, solo cambian estas variables).
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# PUBLIC_BASE_URL se usa para armar la URL pública de cada archivo servido localmente.
PUBLIC_BASE_URL=http://localhost:4000
# Solo con STORAGE_DRIVER=s3. Para Cloudflare R2: S3_ENDPOINT es el endpoint
# de tu cuenta R2 (https://<account_id>.r2.cloudflarestorage.com) y
# S3_PUBLIC_URL_BASE el dominio público que sirve el bucket (custom domain
# o r2.dev). Para AWS S3 real, S3_ENDPOINT puede quedar vacío.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- Moderación de contenido ---
# "stub": aprueba todo automáticamente (para desarrollar sin cuenta de Sightengine).
# "sightengine": llama a la API real (requiere SIGHTENGINE_USER/SIGHTENGINE_SECRET).
MODERATION_MODE=stub
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
